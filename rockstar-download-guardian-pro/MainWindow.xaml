<Window x:Class="RockstarGuardian.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Rockstar Download Guardian Pro" Icon="Assets/guardian.ico" Width="880" Height="730" MinWidth="740" MinHeight="640" Background="#0C121E" Foreground="#EDF2FA" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#1A2638"/><Setter Property="Foreground" Value="#DEE6F4"/><Setter Property="Padding" Value="20,12"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="BorderBrush" Value="#2C3B52"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,28">
  <DockPanel Margin="0,0,0,26">
   <Border DockPanel.Dock="Right" Background="#162536" CornerRadius="12" Padding="12,7" VerticalAlignment="Center"><TextBlock Text="LOCAL E PRIVADO" FontSize="10" FontWeight="SemiBold" Foreground="#A7BDDA"/></Border>
   <Image Source="Assets/guardian.png" Width="52" Height="52" Margin="0,0,13,0" HorizontalAlignment="Left"/>
   <StackPanel VerticalAlignment="Center"><TextBlock Text="Guardian Pro" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="PARA ROCKSTAR GAMES LAUNCHER" FontSize="10" Foreground="#91A1B9" Margin="0,4,0,0"/></StackPanel>
  </DockPanel>
  <TextBlock Text="Você joga. O Guardian fica de olho." FontSize="22" FontWeight="SemiBold"/>
  <TextBlock Text="Retomada automática quando surgir um aviso de erro." Foreground="#98A8BF" FontSize="13" Margin="0,7,0,22"/>
  <Border Background="#141F30" BorderBrush="#293951" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,0,22">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="142"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="ESTADO DA PROTEÇÃO" FontSize="10" Foreground="#91A5C2" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock x:Name="StatusLabel" Text="● Iniciando proteção automática" Foreground="#F3BE54" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="DetailLabel" Text="Aguardando o Launcher." Foreground="#AFBDD1" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
    <Border Grid.Column="2" Background="#101927" CornerRadius="12" Padding="16" VerticalAlignment="Stretch"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="AttemptsLabel" Text="0" FontSize="38" FontWeight="SemiBold" Foreground="#F2F5FA"/><TextBlock Text="novas tentativas&#x0a;nesta sessão" FontSize="11" Foreground="#97A9C2" Margin="0,3,0,0"/></StackPanel></Border>
   </Grid>
  </Border>
  <UniformGrid Columns="3" Margin="0,0,0,23">
   <StackPanel Margin="0,0,18,0"><TextBlock Text="01  OBSERVA" Foreground="#F3BE54" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="Espera o aviso de erro." Foreground="#A9B8CD" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
   <StackPanel Margin="0,0,18,0"><TextBlock Text="02  TENTA NOVAMENTE" Foreground="#F3BE54" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="Aciona o botão disponível." Foreground="#A9B8CD" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
   <StackPanel><TextBlock Text="03  CONTINUA ATENTO" Foreground="#F3BE54" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="Permanece na bandeja." Foreground="#A9B8CD" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
  </UniformGrid>
  <WrapPanel Margin="0,0,0,25"><Button x:Name="ToggleButton" Content="Pausar proteção" Click="ToggleClick" Background="#F3BE54" Foreground="#151B25" BorderBrush="#F3BE54"/><Button Content="Apagar meus dados" Click="DeleteClick"/><Button Content="Sair" Click="ExitClick"/></WrapPanel>
  <DockPanel Margin="0,0,0,9"><TextBlock DockPanel.Dock="Right" Text="SOMENTE NESTA SESSÃO" FontSize="9" Foreground="#7085A3"/><TextBlock Text="ATIVIDADE RECENTE" Foreground="#9AAFCB" FontSize="10" FontWeight="SemiBold"/></DockPanel>
  <Border Background="#101927" BorderBrush="#233149" BorderThickness="1" CornerRadius="12" Padding="3"><TextBox x:Name="Activity" Height="108" Background="Transparent" Foreground="#B5C4D9" FontSize="11" BorderThickness="0" Padding="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Border>
  <Expander Header="Privacidade e funcionamento" Foreground="#91A5C2" FontSize="11" Margin="0,17,0,0"><TextBlock Margin="0,10,0,0" Text="Processamento em memória, sem envio externo ou salvamento da sessão. Apagar meus dados também remove configurações antigas. Ao fechar ou minimizar, o app continua na bandeja. Verde: observação; amarelo: tentativa; cinza: espera ou pausa. Não afiliado à Rockstar Games." Foreground="#91A5C2" TextWrapping="Wrap"/></Expander>
 </StackPanel></ScrollViewer>
</Window>
