<Window x:Class="RockstarGuardian.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Rockstar Download Guardian Pro" Width="840" Height="650" MinWidth="700" MinHeight="560" Background="#101218" Foreground="#EDF0F6" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#F4B942"/><Setter Property="Foreground" Value="#101218"/><Setter Property="Padding" Value="17,11"/><Setter Property="Margin" Value="0,0,10,8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26">
  <TextBlock Text="ROCKSTAR DOWNLOAD" Foreground="#F4B942" FontSize="12" FontWeight="Bold"/>
  <TextBlock Text="Guardian Pro" FontSize="32" FontWeight="Bold"/>
  <TextBlock Text="Deixe o erro com o Guardian." Foreground="#A6B1C6" Margin="0,6,0,0"/>
  <Border Background="#1C212C" CornerRadius="12" Padding="22" Margin="0,24,0,18"><StackPanel>
   <TextBlock x:Name="StatusLabel" Text="● Iniciando proteção automática" Foreground="#F4B942" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock x:Name="DetailLabel" Text="Aguardando avisos com a opção Tentar novamente." Foreground="#BBC5D8" TextWrapping="Wrap" Margin="0,12,0,20"/>
   <TextBlock Text="COMANDOS DE NOVA TENTATIVA ENVIADOS NESTA SESSÃO" Foreground="#A6B1C6" FontSize="11"/>
   <TextBlock x:Name="AttemptsLabel" Text="0" FontSize="32"/>
  </StackPanel></Border>
  <TextBlock Text="Basta abrir e deixar rodando. Quando o Launcher mostrar Tentar novamente ou Retry, o Guardian tentará acionar esse botão sem mover seu mouse. Sem pasta do GTA, medição de velocidade ou configuração inicial." TextWrapping="Wrap" Foreground="#BBC5D8" Margin="0,0,0,16"/>
  <WrapPanel><Button x:Name="ToggleButton" Content="Pausar proteção" Click="ToggleClick"/><Button Content="Apagar meus dados" Click="DeleteClick"/><Button Content="Sair" Click="ExitClick"/></WrapPanel>
  <TextBlock Text="Ao fechar ou minimizar, a proteção continua na bandeja. Verde = observação ativa; amarelo = erro ou comando de nova tentativa; cinza = aguardando ou pausado." Foreground="#A6B1C6" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,14"/>
  <TextBlock Text="Privacidade: caminhos do Launcher, controles e novos trechos do log são processados apenas em memória. Sem envio externo nem salvamento da sessão. O botão de apagar também remove configurações de versões anteriores." TextWrapping="Wrap" Foreground="#A6B1C6" FontSize="12"/>
  <TextBlock Text="ATIVIDADE DA PROTEÇÃO" Foreground="#A6B1C6" FontSize="11" Margin="0,18,0,7"/>
  <TextBox x:Name="Activity" Height="110" Background="#1C212C" Foreground="#EDF0F6" BorderThickness="0" Padding="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
 </StackPanel></ScrollViewer>
</Window>
