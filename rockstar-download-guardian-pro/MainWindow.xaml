<Window x:Class="RockstarGuardian.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Rockstar Download Guardian Pro" Width="1050" Height="880" MinWidth="850" MinHeight="680" Background="#101218" Foreground="#EDF0F6" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#101218"/><Setter Property="Foreground" Value="#EDF0F6"/><Setter Property="BorderBrush" Value="#383E4D"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,5,0,12"/><Setter Property="CaretBrush" Value="White"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#F4B942"/><Setter Property="Foreground" Value="#101218"/><Setter Property="Padding" Value="17,10"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EDF0F6"/><Setter Property="Margin" Value="0,8"/></Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26">
  <DockPanel><TextBlock DockPanel.Dock="Right" Text="LOCAL • WINDOWS 11" Foreground="#A6B1C6" VerticalAlignment="Center" FontSize="11"/><StackPanel><TextBlock Text="ROCKSTAR DOWNLOAD" Foreground="#F4B942" FontSize="12" FontWeight="Bold"/><TextBlock Text="Guardian Pro" FontSize="32" FontWeight="Bold"/><TextBlock Text="Seu download sob observação. Sua máquina sob seu controle." Foreground="#A6B1C6" Margin="0,6,0,0"/></StackPanel></DockPanel>
  <Border Background="#1C212C" CornerRadius="12" Padding="22" Margin="0,24,0,18"><StackPanel>
   <TextBlock x:Name="StatusLabel" Text="● Proteção automática • conectando ao Launcher" Foreground="#F4B942" FontSize="18" FontWeight="SemiBold"/>
   <UniformGrid Columns="3" Margin="0,20,0,16"><StackPanel><TextBlock Text="E/S DE GRAVAÇÃO DO LAUNCHER" Foreground="#A6B1C6" FontSize="11"/><TextBlock x:Name="SpeedLabel" Text="— MB/s" FontSize="30"/></StackPanel><StackPanel><TextBlock Text="DETECÇÃO DO DOWNLOAD" Foreground="#A6B1C6" FontSize="11"/><TextBlock x:Name="SizeLabel" Text="Automático" FontSize="30"/></StackPanel><StackPanel><TextBlock Text="TEMPO ESTIMADO" Foreground="#A6B1C6" FontSize="11"/><TextBlock x:Name="EtaLabel" Text="Sem estimativa" FontSize="30"/></StackPanel></UniformGrid>
   <ProgressBar x:Name="Progress" Height="6" Background="#303747" Foreground="#F4B942" Maximum="100"/>
   <TextBlock x:Name="NetworkLabel" Text="Início automático • nenhuma pasta obrigatória • recuperação em 3 níveis" Foreground="#A6B1C6" Margin="0,12,0,0"/>
   <TextBlock Text="E/S inclui gravações do processo; não mede exclusivamente disco ou tráfego do GTA. ETA e conclusão por tamanho são estimativas." TextWrapping="Wrap" Foreground="#A6B1C6" FontSize="11" Margin="0,8,0,0"/>
  </StackPanel></Border>
  <TextBlock Text="Basta abrir: o Guardian observa processos, interface e logs em memória e tenta retomar falhas automaticamente. Sem envio externo e sem pasta obrigatória. Use Pausar para interromper." Foreground="#A6B1C6" TextWrapping="Wrap" Margin="0,0,0,18"/>
  <Expander Header="Preferências opcionais — pause para editar" Foreground="#EDF0F6" IsExpanded="False"><StackPanel><Grid x:Name="ConfigPanel"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="01  /  SUBSTITUIR DETECÇÃO (OPCIONAL)" Foreground="#F4B942" FontWeight="Bold"/><TextBlock Text="Pasta do GTA V (opcional: somente tamanho e ETA)" Margin="0,12,0,0"/><DockPanel><Button DockPanel.Dock="Right" Content="…" Click="BrowseGame" Margin="8,5,0,12"/><TextBox x:Name="GamePath"/></DockPanel><TextBlock Text="Executável oficial do Rockstar Launcher"/><DockPanel><Button DockPanel.Dock="Right" Content="…" Click="BrowseLauncher" Margin="8,5,0,12"/><TextBox x:Name="LauncherPath"/></DockPanel><TextBlock Text="Arquivo launcher.log (somente leitura)"/><DockPanel><Button DockPanel.Dock="Right" Content="…" Click="BrowseLog" Margin="8,5,0,12"/><TextBox x:Name="LogPath"/></DockPanel></StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="02  /  AUTOMAÇÃO" Foreground="#F4B942" FontWeight="Bold"/><TextBlock Text="Tamanho alvo em GB decimais" Margin="0,12,0,0"/><TextBox x:Name="Target" Text="115"/><CheckBox x:Name="ShutdownOption" Content="Desligar automaticamente após atingir o alvo"/><TextBlock Text="Exige atividade observada e 60 s estáveis. Pode confundir arquivos pré-alocados com download completo. Confirme o tamanho do seu jogo. Ao disparar, haverá mais 60 s para cancelar." TextWrapping="Wrap" Foreground="#A6B1C6" FontSize="12"/><TextBlock Text="Ao fechar ou minimizar, o Guardian permanece na bandeja. Use Sair para encerrar." TextWrapping="Wrap" Foreground="#A6B1C6" Margin="0,12,0,0"/></StackPanel>
  </Grid>
  <Border Background="#1C212C" CornerRadius="8" Padding="14" Margin="0,10,0,14"><StackPanel><TextBlock Text="Privacidade • processamento local" FontWeight="Bold"/><TextBlock Text="A observação automática usa processos e logs apenas em memória, sem envio externo. Somente se você optar por salvar preferências, os caminhos serão gravados no JSON local com seu consentimento. Apagar dados remove esse JSON e limpa a sessão." TextWrapping="Wrap" Foreground="#A6B1C6" Margin="0,5"/><CheckBox x:Name="Consent" Content="Autorizo salvar localmente os caminhos e preferências opcionais."/></StackPanel></Border>
  <Button Content="Salvar preferências opcionais" Click="SaveClick" HorizontalAlignment="Left" Margin="0,0,0,15"/></StackPanel></Expander>
  <WrapPanel Margin="0,16,0,0"><Button x:Name="ToggleButton" Content="Pausar monitoramento" Click="ToggleClick"/><Button Content="Reiniciar Launcher" Click="RestartClick"/><Button Content="Apagar meus dados" Click="DeleteClick"/><Button Content="Sair" Click="ExitClick"/></WrapPanel>
  <Border x:Name="ShutdownPanel" Visibility="Collapsed" Background="#6B2525" Padding="14" CornerRadius="8" Margin="0,14,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Cancelar desligamento" Click="CancelShutdownClick"/><TextBlock x:Name="ShutdownLabel" VerticalAlignment="Center"/></DockPanel></Border>
  <TextBlock Text="ATIVIDADE DA SESSÃO" Foreground="#A6B1C6" FontSize="11" Margin="0,22,0,7"/><TextBox x:Name="Activity" Height="110" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
 </StackPanel></ScrollViewer>
</Window>
